# Maintainer: bolens <https://github.com/bolens>
# From-source package: builds the Go dispatcher from the tagged source tree.
pkgname=millennium-helpers
pkgver=4.0.0
pkgrel=1
pkgdesc="Millennium helpers (from source) — Go strangler CLI plus shell helpers/MCP"
arch=('x86_64' 'aarch64')
url="https://github.com/bolens/millennium-helpers"
license=('MIT')
depends=('bash' 'curl' 'unzip' 'python' 'sudo')
makedepends=('go')
optdepends=(
  'jq: enhanced JSON parsing for updates'
  'systemd: daily update timer scheduler'
  'libnotify: desktop notifications for background update status'
  'flatpak: compatibility with Flatpak Steam'
  'cronie: alternative daily update timer scheduler via cron (fallback)'
)
conflicts=("${pkgname}-git" "${pkgname}-bin")
install=millennium-helpers.install
backup=('etc/sudoers.d/millennium-helpers')
_srcarchive="millennium-helpers-v${pkgver}-src.tar.gz"
_srcdir="millennium-helpers-${pkgver}"
source=("${url}/releases/download/v${pkgver}/millennium-helpers-v${pkgver}-src.tar.gz"
        "millennium-helpers.sudoers")
noextract=("${_srcarchive}")
sha256sums=('a90fe34e27d12afc042458ff9e700491226c27727a533a091e9f0e7f30ade71d'
            'b242d171bced3313da83fb6bfd6b29fdaf17fec28892b6e38435d7dd321949bd')

prepare() {
  mkdir -p "${srcdir}/${_srcdir}"
  bsdtar -xf "${srcdir}/${_srcarchive}" --strip-components=1 -C "${srcdir}/${_srcdir}"
  # shellcheck source=/dev/null
  source "${startdir}/arch-unix-install.sh"
  _arch_prepare_manual_conflict_check
}

build() {
  cd "${srcdir}/${_srcdir}"
  export CGO_ENABLED=0
  make build
}

package() {
  # shellcheck source=/dev/null
  source "${startdir}/arch-unix-install.sh"
  install -Dm440 "${srcdir}/millennium-helpers.sudoers" "${pkgdir}/etc/sudoers.d/millennium-helpers"
  cd "${srcdir}/${_srcdir}"
  _arch_install_unix_helpers
}
